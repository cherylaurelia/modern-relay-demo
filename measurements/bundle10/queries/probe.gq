query v0($q: Vector(1536)) {
  match { $d: Doc0 }
  return { $d.slug }
  order { nearest($d.embedding, $q) }
  limit 10
}

query t0($q: String) {
  match { $d: Doc0 }
  return { $d.slug }
  order { bm25($d.body, $q) desc }
  limit 10
}

